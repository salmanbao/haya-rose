# =============================================================================
# Medusa Backend — Environment Variables (names only)
# -----------------------------------------------------------------------------
# Copy this file to `apps/backend/.env` and fill in the values.
# Never commit real secrets. Production values must come from the deployment
# secret manager, not this file.
#
# This list documents the variables used by the generated Medusa v2 (2.19.0)
# baseline. Payment-provider variables are intentionally absent: no payment
# provider has been selected yet. TCS/Aramex shipping credentials are absent
# for the same reason.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. PostgreSQL is the authoritative source of truth
# for persistent commerce state.
# Dev:     postgres://medusa:<dev-password>@localhost/medusa-baby-store
# Prod:    managed/VPS PostgreSQL connection string (never commit credentials)
DATABASE_URL=

# --- Redis (supporting infrastructure only — never authoritative data) ------
# REQUIRED. Used by Medusa's Redis-backed cache/event-bus/workflow-engine/
# locking modules, wired unconditionally in medusa-config.ts (approved
# decision: REDIS WIRING = ENABLE NOW). Redis never holds authoritative
# commerce state — PostgreSQL does. Tests also require Redis: the integration
# runner boots the real medusa-config.ts.
# Dev:     redis://localhost:6379
REDIS_URL=
# Enables Medusa's core graph-query caching (native feature flag, verified in
# installed 2.19.0: MEDUSA_FF_CACHING, default false). With the CACHING module
# wired to Redis in medusa-config.ts, store browse queries are cached in Redis
# under the "mc:" key prefix and invalidated via tag events. Optional: caching
# degrades to cache-miss when unset.
MEDUSA_FF_CACHING=true

# --- CORS -------------------------------------------------------------------
# Allowed origins for store, admin, and auth requests.
# Dev:
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
# Prod:    replace with the deployed storefront/admin origins (e.g. https://<storefront-domain>)

# --- Secrets (server-side only; never expose to the Next.js client) ---------
# Dev:     any local value. Prod: strong random values from the secret manager.
JWT_SECRET=
COOKIE_SECRET=
# Required by Medusa for admin MFA encryption (64 hex chars). Dev: random local value.
AUTH_MFA_ENCRYPTION_KEY=
# Master key for AES-256-GCM encryption of Admin-managed payment-provider
# secrets at rest (payment-config module). Provider credentials themselves
# are managed through the Admin UI (Settings → Payment Providers) and are
# NEVER configured here. This key must be a 64-character hex string (32
# bytes); generate with `openssl rand -hex 32`. Same value across all
# backend processes; rotation requires re-encrypting stored secrets.
PAYMENT_CONFIG_ENCRYPTION_KEY=

# --- Customer authentication (email/password + Google OAuth) -----------------
# Session lifetime for customer/storefront JWTs (native Medusa default, kept
# explicit). The storefront _medusa_jwt cookie must stay aligned (1 day).
JWT_EXPIRES_IN=1d
# Email verification: REQUIRED for emailpass customers (approved BD-AUTH-01).
# Configured natively via http.authVerificationsPerActor in medusa-config.ts.
# Google OAuth: ENV-GATED (approved BD-AUTH-03) — the provider registers only
# when AUTH_GOOGLE_ENABLED=true AND all GOOGLE_* variables are set. Keep the
# gate OFF (false) until real Google Cloud OAuth credentials are available;
# never enable it with placeholder credentials.
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public callback URL on the storefront (e.g. https://<storefront>/api/auth/callback/google)
GOOGLE_CALLBACK_URL=

# --- Admin onboarding (development only) ------------------------------------
# Tells the Medusa Admin onboarding flow which frontend is used.
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
# Absolute path to the Next.js storefront (used by the onboarding flow).
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=

# --- Node -------------------------------------------------------------------
# development | production | test
NODE_ENV=development

# --- Media & Storage (Cloudflare R2 via Medusa file module) -----------------
# FILE_PROVIDER selects the file storage provider:
#   unset (default) → Medusa's local provider (dev/test; serves <cwd>/static at /static)
#   s3             → Cloudflare R2 via the native file-s3 provider (production)
# When FILE_PROVIDER=s3, all S3_* variables below are required.
FILE_PROVIDER=
# Public delivery base URL for stored files (e.g. R2 custom domain or CDN
# fronting the bucket — NOT assumed to be the raw r2.cloudflarestorage.com URL).
S3_FILE_URL=
# Cloudflare R2 API token credentials (Access Key ID / Secret Access Key).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 region is always "auto".
S3_REGION=auto
# R2 bucket name.
S3_BUCKET=
# R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Optional key prefix within the bucket (e.g. "products/").
S3_PREFIX=
# Maximum accepted upload size in MB (default 5). Applied server-side on
# POST /admin/uploads. MIME allowlist is fixed (images only: jpeg/png/webp/gif/avif).
MEDUSA_UPLOAD_MAX_SIZE_MB=5

# --- Payments -----------------------------------------------------------------
# PAYMENT_PROVIDER selects which payment provider(s) are REGISTERED in
# medusa-config.ts (infrastructure choice — which provider modules the backend
# loads). Comma-separated list; unset (default) → only the native system
# provider (dev/test; no real charges). Approved topology (V1):
#   safepay → Safepay for the Pakistan/PKR market (BD-P-01, revised 2026-08-17)
#   stripe  → Stripe for the UAE/AED market (approved provider BD-P-02)
# Typical production value: PAYMENT_PROVIDER=safepay,stripe
#
# CREDENTIALS ARE ADMIN-MANAGED (approved architecture 2026-08-17): configure
# each provider's keys, environment, and enable/disable state in the Medusa
# Admin (Settings → Payment Providers). Secrets are encrypted at rest in
# PostgreSQL (master key PAYMENT_CONFIG_ENCRYPTION_KEY above) and are never
# returned to the browser. The provider-specific variables below are
# TRANSITIONAL legacy fallbacks ONLY (precedence: Admin-managed configuration
# > legacy environment configuration); they are not required for boot and
# should be removed once configuration has been migrated through the Admin.
PAYMENT_PROVIDER=
# --- Safepay (Pakistan/PKR) — TRANSITIONAL legacy fallback; use the Admin UI.
# Public merchant API key (sec_...) sent as merchant_api_key (Safepay Dashboard).
SAFEPAY_MERCHANT_API_KEY=
# Secret key sent as the x-sfpy-merchant-secret header on API calls (server-side only).
SAFEPAY_SECRET_KEY=
# Shared webhook secret from the Safepay Developer Dashboard. Verifies the
# X-SFPY-SIGNATURE header (HMAC-SHA512 over the raw body) on
# POST /hooks/payment/safepay_safepay.
SAFEPAY_WEBHOOK_SECRET=
# Safepay environment: sandbox (default) | production.
SAFEPAY_ENVIRONMENT=sandbox
# Storefront return URL after the customer completes hosted checkout.
SAFEPAY_REDIRECT_URL=
# Storefront URL for customer-cancelled checkouts.
SAFEPAY_CANCEL_URL=
# --- Stripe (UAE/AED) — TRANSITIONAL legacy fallback; use the Admin UI.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (client-side, non-secret). The storefront reads its
# own copy from its env (NEXT_PUBLIC_STRIPE_KEY).
STRIPE_PUBLISHABLE_KEY=
# Capture mode for Stripe PaymentIntents: unset (default) → manual (deferred)
# capture per T-PAY-03; "automatic" → capture at authorization.
PAYMENT_STRIPE_CAPTURE=
