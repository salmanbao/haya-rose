# =============================================================================
# Medusa Backend — Environment Variables (names only)
# -----------------------------------------------------------------------------
# Copy this file to `apps/backend/.env` and fill in the values.
# Never commit real secrets. Production values must come from the deployment
# secret manager, not this file.
#
# This list documents the variables used by the generated Medusa v2 (2.19.0)
# baseline. Payment-provider variables are intentionally absent: no payment
# provider has been selected yet. TCS/Aramex shipping credentials are absent
# for the same reason.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. PostgreSQL is the authoritative source of truth
# for persistent commerce state.
# Dev:     postgres://medusa:<dev-password>@localhost/medusa-baby-store
# Prod:    managed/VPS PostgreSQL connection string (never commit credentials)
DATABASE_URL=

# --- Redis (supporting infrastructure only — never authoritative data) ------
# Used by Medusa's Redis-based caching/event-bus/workflow-engine/locking
# modules when explicitly enabled in medusa-config.ts. The generated baseline
# runs with in-memory fallbacks and does not wire Redis yet.
# Dev:     redis://localhost:6379
REDIS_URL=

# --- CORS -------------------------------------------------------------------
# Allowed origins for store, admin, and auth requests.
# Dev:
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
# Prod:    replace with the deployed storefront/admin origins (e.g. https://<storefront-domain>)

# --- Secrets (server-side only; never expose to the Next.js client) ---------
# Dev:     any local value. Prod: strong random values from the secret manager.
JWT_SECRET=
COOKIE_SECRET=
# Required by Medusa for admin MFA encryption (64 hex chars). Dev: random local value.
AUTH_MFA_ENCRYPTION_KEY=

# --- Admin onboarding (development only) ------------------------------------
# Tells the Medusa Admin onboarding flow which frontend is used.
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
# Absolute path to the Next.js storefront (used by the onboarding flow).
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=

# --- Node -------------------------------------------------------------------
# development | production | test
NODE_ENV=development

# --- Media & Storage (Cloudflare R2 via Medusa file module) -----------------
# FILE_PROVIDER selects the file storage provider:
#   unset (default) → Medusa's local provider (dev/test; serves <cwd>/static at /static)
#   s3             → Cloudflare R2 via the native file-s3 provider (production)
# When FILE_PROVIDER=s3, all S3_* variables below are required.
FILE_PROVIDER=
# Public delivery base URL for stored files (e.g. R2 custom domain or CDN
# fronting the bucket — NOT assumed to be the raw r2.cloudflarestorage.com URL).
S3_FILE_URL=
# Cloudflare R2 API token credentials (Access Key ID / Secret Access Key).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 region is always "auto".
S3_REGION=auto
# R2 bucket name.
S3_BUCKET=
# R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Optional key prefix within the bucket (e.g. "products/").
S3_PREFIX=
# Maximum accepted upload size in MB (default 5). Applied server-side on
# POST /admin/uploads. MIME allowlist is fixed (images only: jpeg/png/webp/gif/avif).
MEDUSA_UPLOAD_MAX_SIZE_MB=5

# --- Payments -----------------------------------------------------------------
# PAYMENT_PROVIDER selects the payment provider(s) registered in medusa-config.ts:
#   unset (default) → only the native system provider (dev/test; no real charges)
#   stripe          → Stripe for the UAE/AED market (approved provider BD-P-02)
# When PAYMENT_PROVIDER=stripe, STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are
# required. AssanPay (PK/PKR, approved BD-P-01) is NOT yet registered: its
# official contract (auth, webhooks, refunds) is still pending verification.
PAYMENT_PROVIDER=
# Stripe secret key (server-side only; never expose to the Next.js client).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for POST /hooks/payment/stripe. Required for
# signature verification of webhook-dependent flows (3DS, async capture).
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (client-side, non-secret). Used by the storefront to
# render Stripe checkout; the storefront reads its own copy from its env.
STRIPE_PUBLISHABLE_KEY=
# Capture mode for Stripe PaymentIntents: unset (default) → manual (deferred)
# capture per T-PAY-03; "automatic" → capture at authorization.
PAYMENT_STRIPE_CAPTURE=
