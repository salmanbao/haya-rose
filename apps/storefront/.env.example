# =============================================================================
# Next.js Storefront — Environment Variables (names only)
# -----------------------------------------------------------------------------
# Copy this file to `apps/storefront/.env.local` and fill in the values.
# Never commit real secrets.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser. Backend secrets
# (DATABASE_URL, JWT_SECRET, ...) must stay in the backend and must never be
# added here.
#
# Stripe and Medusa Cloud S3 variables are OPTIONAL and only relevant if those
# integrations are enabled. No payment provider has been selected yet, so
# NEXT_PUBLIC_STRIPE_KEY is currently unused.
# =============================================================================

# --- Medusa backend connection ----------------------------------------------
# Publishable API key created in Medusa Admin → Settings → API Key Management.
# create-medusa-app generated one automatically and stored it in .env.local.
# Prod:    a production publishable key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_<replace-with-publishable-key>

# URL of the Medusa backend API server.
# Dev:  http://localhost:9000
# Prod: https://<medusa-backend-domain>
NEXT_PUBLIC_MEDUSA_BACKEND_URL=

# Enabled markets (comma-separated country codes). The market selector page
# at / lists exactly these markets, derived from the backend regions.
# Dev:  pk,ae
NEXT_PUBLIC_ENABLED_MARKETS=pk,ae

# Legacy starter variable — no longer used for market routing (BD-M-01:
# URL country code is canonical; undetermined location routes to the
# selector). Kept for backward compatibility with the starter.
NEXT_PUBLIC_DEFAULT_REGION=

# Base URL of the storefront itself (used to build absolute URLs).
# Dev:  http://localhost:8000
# Prod: https://<storefront-domain>
NEXT_PUBLIC_BASE_URL=

# --- Optional integrations (NOT enabled in the baseline) --------------------
# Stripe publishable key — only if the Stripe payment provider is enabled.
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname/path — only for Medusa Cloud deployments.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# --- Node -------------------------------------------------------------------
NODE_ENV=development
